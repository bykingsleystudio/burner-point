# Burner Point environment configuration
# Keep real secrets only in ignored .env files or deployment dashboards.
# .env.example files use placeholder values only.

# =========================================
# WEB PUBLIC ENV
# =========================================
NEXT_PUBLIC_API_URL=https://burner-point-api-production.up.railway.app/api
NEXT_PUBLIC_WS_URL=https://burner-point-api-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=REPLACE_ME
NEXT_PUBLIC_PADDLE_SANDBOX=true

# =========================================
# CLERK AUTH
# =========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# =========================================
# SENTRY / OBSERVABILITY
# =========================================
SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
# Optional: only needed for Sentry source-map upload and release tracking during builds.
SENTRY_AUTH_TOKEN=sntrys_REPLACE_ME
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT=REPLACE_ME

# =========================================
# PLAYWRIGHT E2E (OPTIONAL)
# =========================================
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_PORT=3000
PW_E2E_SMOKE_IDENTIFIER=qa-burner-point@example.com
PW_E2E_SMOKE_PASSWORD=REPLACE_ME
PW_E2E_RUN_LIVE_OAUTH=false


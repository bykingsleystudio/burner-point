NEXT_PUBLIC_API_URL=https://burner-point-api-production.up.railway.app/api
NEXT_PUBLIC_WS_URL=https://burner-point-api-production.up.railway.app
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=https://your_real_web_dsn_here

# Clerk Auth
# Create the Burner Point app in Clerk Dashboard first, then paste real pk_test/pk_live and sk_test/sk_live values here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_test_or_sk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Optional future sync only; not required for basic sign-up/sign-in.
# CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

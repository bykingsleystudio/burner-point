{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.burnerpoint.com" }],
      "destination": "https://burnerpoint.com/:path*",
      "permanent": true
    }
  ]
}

# Burner Point environment configuration
# Keep real secrets only in ignored .env files or deployment dashboards.
# .env.example files use placeholder values only.

# =========================================
# APP / ENVIRONMENT
# =========================================
NODE_ENV=development
APP_ENV=development
APP_NAME=Burner Point
APP_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3001/api
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =========================================
# DATABASE / CACHE
# =========================================
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_HOST=HOST
DB_PORT=5432
DB_USER=USERNAME
DB_PASS=PASSWORD
DB_NAME=DATABASE
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD

# =========================================
# JWT / INTERNAL SECURITY
# =========================================
JWT_ACCESS_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=REPLACE_ME_32_CHAR_KEY
ADMIN_SECRET_KEY=REPLACE_ME

# =========================================
# CLERK AUTH
# =========================================
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# =========================================
# LEGACY OAUTH LAUNCH URLS
# =========================================
GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth?client_id=REPLACE_ME
APPLE_OAUTH_URL=https://appleid.apple.com/auth/authorize?client_id=REPLACE_ME
MICROSOFT_OAUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=REPLACE_ME

# =========================================
# TELECOM PROVIDERS
# =========================================
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_API_KEY=SK_REPLACE_ME
TWILIO_API_SECRET=REPLACE_ME
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_ME
TWILIO_DEFAULT_FROM=+10000000000
TWILIO_WEBHOOK_SECRET=REPLACE_ME
SMS_DEFAULT_FROM=BurnerPoint
VONAGE_API_KEY=REPLACE_ME
VONAGE_API_SECRET=REPLACE_ME
VONAGE_APPLICATION_ID=REPLACE_ME
VONAGE_PRIVATE_KEY=REPLACE_ME
VONAGE_DEFAULT_FROM=BurnerPoint
VONAGE_WEBHOOK_SECRET=REPLACE_ME
INFOBIP_BASE_URL=https://REPLACE_ME.api.infobip.com
INFOBIP_API_KEY=REPLACE_ME
INFOBIP_DEFAULT_FROM=BurnerPoint
INFOBIP_SENDER_ID=BurnerPoint
INFOBIP_WEBHOOK_SECRET=REPLACE_ME

# =========================================
# AI / OPENAI
# =========================================
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
AI_KILL_SWITCH=false

# =========================================
# PAYMENTS
# =========================================
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_ME
FLUTTERWAVE_ENCRYPTION_KEY=REPLACE_ME
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_ME
SQUAD_SECRET_KEY=sandbox_sk_REPLACE_ME
SQUAD_PUBLIC_KEY=sandbox_pk_REPLACE_ME
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_WEBHOOK_SECRET=REPLACE_ME
KORAPAY_SECRET_KEY=sk_test_REPLACE_ME
KORAPAY_PUBLIC_KEY=pk_test_REPLACE_ME
KORAPAY_ENCRYPTION_KEY=REPLACE_ME
KORAPAY_WEBHOOK_SECRET=REPLACE_ME
OPAY_MERCHANT_ID=REPLACE_ME
OPAY_PUBLIC_KEY=REPLACE_ME
OPAY_PRIVATE_KEY=REPLACE_ME
OPAY_SECRET_KEY=REPLACE_ME
OPAY_BASE_URL=https://sandboxapi.opayweb.com
OPAY_WEBHOOK_SECRET=REPLACE_ME
PADDLE_API_KEY=REPLACE_ME
PADDLE_CLIENT_TOKEN=REPLACE_ME
PADDLE_WEBHOOK_SECRET=REPLACE_ME
PADDLE_SANDBOX=true
PADDLE_PRODUCT_ID_CREDITS=pro_REPLACE_ME
PADDLE_PRODUCT_ID_RENTAL=pro_REPLACE_ME
PADDLE_PRODUCT_ID_SUB=pro_REPLACE_ME
PADDLE_PRICE_VERIFICATION=pri_REPLACE_ME
PADDLE_PRICE_RENTAL=pri_REPLACE_ME
PADDLE_PRICE_SUB_MONTHLY=pri_REPLACE_ME
NOWPAYMENTS_API_KEY=REPLACE_ME
NOWPAYMENTS_IPN_SECRET=REPLACE_ME
NOWPAYMENTS_SANDBOX=true
SECONDARY_GATEWAYS_ENABLED=false
MOBILE_EXTERNAL_PAYMENTS_ENABLED=false

# =========================================
# EMAIL / RESEND
# =========================================
RESEND_API_KEY=re_REPLACE_ME
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_ME
SMTP_FROM=noreply@burnerpoint.app
EMAIL_FROM=noreply@burnerpoint.app

# =========================================
# SENTRY / OBSERVABILITY
# =========================================
SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
SENTRY_AUTH_TOKEN=sntrys_REPLACE_ME
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT=REPLACE_ME

# =========================================
# API OPERATIONS
# =========================================
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_TTL_MS=600000
PAYMENT_RATE_LIMIT_MAX=10
INDEXNOW_KEY=REPLACE_ME


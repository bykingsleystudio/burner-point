# ══════════════════════════════════════════════════════════════════
# BurnerPoint — Complete Environment Configuration
# NEVER commit this file. NEVER expose these to the frontend.
# All values must live server-side only.
# ══════════════════════════════════════════════════════════════════
#
# ─── Railway (API service → Variables → Raw Editor) ─────────────
# If Postgres/Redis are separate Railway plugins, reference them so
# credential rotation never breaks the app:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
# (Plugin service names in Railway must match "Postgres" / "Redis" above.)
#
# ─── Application ──────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint

# ─── Database ─────────────────────────────────────────────────────
# Local dev: full URL. Production on Railway: use DATABASE_URL reference above.
DATABASE_URL=postgresql://burnerpoint:secret@localhost:5432/burnerpoint
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis (rate limiting + session storage) ──────────────────────
# Local dev. Production on Railway: use REDIS_URL reference above.
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=GENERATE_MIN_64_CHARS_hex
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHARS_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=GENERATE_32_CHARS_hex  # NEVER CHANGE AFTER LAUNCH
ADMIN_SECRET_KEY=GENERATE_STRONG_SECRET

# ─── Twilio (SMS, Calls, OTP) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFAULT_FROM=+15550000000
TWILIO_WEBHOOK_SECRET=set_after_railway_deploy

# ─── Telnyx (fallback provider) ───────────────────────────────────
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_CONNECTION_ID=your_connection_id

# ─── OpenAI (AI message classification) ───────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
AI_KILL_SWITCH=false   # Set true to disable all AI calls instantly

# ─── Payment Gateways ─────────────────────────────────────────────

# 1. Flutterwave (NGN primary)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_WEBHOOK_HASH=your_strong_secret_hash

# 2. Paystack (NGN)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# 3. Squad by GTCO (NGN)
SQUAD_SECRET_KEY=sandbox_sk_xxxxxxxxxxxxxxxxxxxx
SQUAD_PUBLIC_KEY=sandbox_pk_xxxxxxxxxxxxxxxxxxxx
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# 4. Korapay (NGN)
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# 5. OPay Merchant (NGN)
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_PUBLIC_KEY=your_opay_public_key
OPAY_PRIVATE_KEY=your_opay_private_key
OPAY_BASE_URL=https://sandboxapi.opayweb.com

# 6. Paddle (International — Cards + Subscriptions)
# Get from: vendors.paddle.com → Developer Tools → Authentication
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token  # for frontend Paddle.js (public, safe to expose)
PADDLE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PADDLE_SANDBOX=true  # false in production

# Paddle Products (create in Catalog → Products)
PADDLE_PRODUCT_ID_CREDITS=pro_xxxxxxxxxxxxxxxx   # One-time: verifications
PADDLE_PRODUCT_ID_RENTAL=pro_xxxxxxxxxxxxxxxx    # One-time: phone rentals
PADDLE_PRODUCT_ID_SUB=pro_xxxxxxxxxxxxxxxx       # Subscription: monthly plan

# Paddle Prices (create in Catalog → Prices, inside each product)
PADDLE_PRICE_VERIFICATION=pri_xxxxxxxxxxxxxxxx   # $0.99 one-time
PADDLE_PRICE_RENTAL=pri_xxxxxxxxxxxxxxxx         # $5.00 one-time (1-14 days)
PADDLE_PRICE_SUB_MONTHLY=pri_xxxxxxxxxxxxxxxx    # $15.99/month recurring

# 7. NOWPayments (Crypto)
# Get from: nowpayments.io → My Account → API Keys
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SANDBOX=true

# ─── Email (Resend SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@burnerpoint.app

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000          # 1 minute window
RATE_LIMIT_MAX_REQUESTS=60       # 60 req/min global
AUTH_RATE_LIMIT_MAX=5            # 5 attempts per window
AUTH_RATE_LIMIT_TTL_MS=600000    # 10 minute lockout
PAYMENT_RATE_LIMIT_MAX=10        # 10 payment inits per window

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://burnerpoint.app,https://www.burnerpoint.app

# ─── Misc ─────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ══════════════════════════════════════════════════════════════════
# BurnerPoint — Complete Environment Configuration
# NEVER commit this file. NEVER expose these to the frontend.
# All values must live server-side only.
# ══════════════════════════════════════════════════════════════════
#
# ─── Railway (API service → Variables → Raw Editor) ─────────────
# Database target: Neon Postgres. Set DATABASE_URL to the Neon connection
# string with sslmode=require. DBeaver uses the same Neon host, port,
# database, user, password, and SSL mode.
#
# Railway API service (Variables -> Raw Editor) should still reference
# Railway Redis if you use Railway Redis for cache/queues:
#   REDIS_URL=${{Redis.REDIS_URL}}
#
# ─── Application ──────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint

# OAuth / SSO provider authorization URLs
# These power /api/auth/oauth/google, /api/auth/oauth/apple, and /api/auth/oauth/microsoft.
# Replace placeholders with the full provider authorization URL generated for your OAuth app.
GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth?client_id=REPLACE_ME
APPLE_OAUTH_URL=https://appleid.apple.com/auth/authorize?client_id=REPLACE_ME
MICROSOFT_OAUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=REPLACE_ME

# ─── Database ─────────────────────────────────────────────────────
# Local dev/staging/prod: use the Neon Postgres connection string for the
# matching Neon branch/database. Never commit real Neon credentials.
DATABASE_URL=postgresql://neon_user:neon_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neon_user
DB_PASS=neon_password
DB_NAME=neondb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis (rate limiting + session storage) ──────────────────────
# Local dev. Production on Railway: use REDIS_URL reference above.
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=GENERATE_MIN_64_CHARS_hex
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHARS_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=GENERATE_32_CHARS_hex  # NEVER CHANGE AFTER LAUNCH
ADMIN_SECRET_KEY=GENERATE_STRONG_SECRET

# Clerk Auth (identity authority for web + mobile; API exchanges Clerk sessions for Burner Point API tokens)
CLERK_SECRET_KEY=sk_test_or_sk_live_REPLACE_ME
# Optional future Clerk webhook sync for user.created/user.updated; not required for basic sign-up/sign-in.
# CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Twilio (SMS, Calls, OTP) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFAULT_FROM=+15550000000
TWILIO_WEBHOOK_SECRET=set_after_railway_deploy

# ─── Telnyx (fallback provider) ───────────────────────────────────
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_CONNECTION_ID=your_connection_id

# ─── OpenAI (AI message classification) ───────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
AI_KILL_SWITCH=false   # Set true to disable all AI calls instantly

# ─── Payment Gateways ─────────────────────────────────────────────

# 1. Flutterwave (NGN primary)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_WEBHOOK_HASH=your_strong_secret_hash

# 2. Paystack (NGN)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# 3. Squad by GTCO (NGN)
SQUAD_SECRET_KEY=sandbox_sk_xxxxxxxxxxxxxxxxxxxx
SQUAD_PUBLIC_KEY=sandbox_pk_xxxxxxxxxxxxxxxxxxxx
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# 4. Korapay (NGN)
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# 5. OPay Merchant (NGN)
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_PUBLIC_KEY=your_opay_public_key
OPAY_PRIVATE_KEY=your_opay_private_key
OPAY_BASE_URL=https://sandboxapi.opayweb.com

# 6. Paddle (International — Cards + Subscriptions)
# Get from: vendors.paddle.com → Developer Tools → Authentication
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token  # for frontend Paddle.js (public, safe to expose)
PADDLE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PADDLE_SANDBOX=true  # false in production

# Paddle Products (create in Catalog → Products)
PADDLE_PRODUCT_ID_CREDITS=pro_xxxxxxxxxxxxxxxx   # One-time: verifications
PADDLE_PRODUCT_ID_RENTAL=pro_xxxxxxxxxxxxxxxx    # One-time: phone rentals
PADDLE_PRODUCT_ID_SUB=pro_xxxxxxxxxxxxxxxx       # Subscription: monthly plan

# Paddle Prices (create in Catalog → Prices, inside each product)
PADDLE_PRICE_VERIFICATION=pri_xxxxxxxxxxxxxxxx   # $0.99 one-time
PADDLE_PRICE_RENTAL=pri_xxxxxxxxxxxxxxxx         # $5.00 one-time (1-14 days)
PADDLE_PRICE_SUB_MONTHLY=pri_xxxxxxxxxxxxxxxx    # $15.99/month recurring

# 7. NOWPayments (Crypto)
# Get from: nowpayments.io → My Account → API Keys
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SANDBOX=true

# ─── Email (Resend SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@burnerpoint.app

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000          # 1 minute window
RATE_LIMIT_MAX_REQUESTS=60       # 60 req/min global
AUTH_RATE_LIMIT_MAX=5            # 5 attempts per window
AUTH_RATE_LIMIT_TTL_MS=600000    # 10 minute lockout
PAYMENT_RATE_LIMIT_MAX=10        # 10 payment inits per window

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://burnerpoint.app,https://www.burnerpoint.app

# ─── Misc ─────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Production operations
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com
BETTERSTACK_SOURCE_TOKEN=your_betterstack_source_token
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxxx
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=burnerpoint-artifacts
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# Provider routing controls
SECONDARY_GATEWAYS_ENABLED=false
MOBILE_EXTERNAL_PAYMENTS_ENABLED=false
BANDWIDTH_ACCOUNT_ID=your_bandwidth_account_id
BANDWIDTH_API_TOKEN=your_bandwidth_api_token
SMS_DEFAULT_FROM=BurnerPoint
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_DEFAULT_FROM=BurnerPoint
INFOBIP_BASE_URL=https://xxxx.api.infobip.com
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_DEFAULT_FROM=BurnerPoint
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
TERMII_API_KEY=your_termii_api_key

# Add-on platform providers
ONEGLOBAL_API_BASE_URL=https://api.1global.com
ONEGLOBAL_API_KEY=your_1global_api_key
BRIGHTDATA_CUSTOMER_ID=your_brightdata_customer_id
BRIGHTDATA_API_TOKEN=your_brightdata_api_token
WIREGUARD_CONTROL_PLANE_URL=https://vpn-control.burnerpoint.app
WIREGUARD_CONTROL_PLANE_TOKEN=your_wireguard_control_plane_token

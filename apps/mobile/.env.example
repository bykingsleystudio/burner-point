# Copy to `.env` for local overrides (optional).
# Production defaults are set in `src/lib/config.ts` and EAS `preview` / `production` profiles.

EXPO_PUBLIC_API_URL=https://burner-point-api-production.up.railway.app/api
EXPO_PUBLIC_WEB_URL=https://burnerpoint.vercel.app
EXPO_PUBLIC_SENTRY_DSN=https://your_real_mobile_dsn_here
# Create the Burner Point app in Clerk Dashboard first, then paste the real Expo-safe publishable key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_REPLACE_ME

# Local backend example:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
# EXPO_PUBLIC_WEB_URL=http://localhost:3000

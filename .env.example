# ============================================================
# Burner Point — Production Environment Template
# ============================================================
# IMPORTANT:
# - This file contains configuration names/defaults only.
# - NEVER place real secrets in this file.
# - Real secrets belong in the local .env (gitignored),
#   Railway environment variables, or Vercel environment variables.
# - Canonical brand: Burner Point
# - Canonical web URL: https://burnerpoint.com
# - Canonical API URL: https://api.burnerpoint.com
# ============================================================

# ============================================================
# CORE APPLICATION
# ============================================================

NODE_ENV=production
APP_NAME=Burner Point

APP_URL=https://burnerpoint.com
API_URL=https://api.burnerpoint.com

FOREXRATEAPI_API_KEY=
FOREXRATEAPI_BASE_URL=https://api.forexrateapi.com

CORS_ALLOWED_ORIGINS=https://burnerpoint.com
CORS_ALLOW_VERCEL_PREVIEWS=false

# ============================================================
# SUPABASE — DATABASE / AUTH / STORAGE / REALTIME
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Auth security / OAuth
WEBAUTHN_RP_NAME=Burner Point
WEBAUTHN_RP_ID=burnerpoint.com
WEBAUTHN_ORIGIN=https://burnerpoint.com
OAUTH_ISSUER=https://api.burnerpoint.com/api/oauth

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL connection strings from Supabase
DATABASE_URL=
DIRECT_DATABASE_URL=
POOLER_URL=

# Storage buckets
SUPABASE_STORAGE_USER_UPLOADS_BUCKET=bp-user-uploads
SUPABASE_STORAGE_MEDIA_BUCKET=bp-media
SUPABASE_STORAGE_VERIFICATION_ASSETS_BUCKET=bp-verification-assets
SUPABASE_STORAGE_DOCUMENTS_BUCKET=bp-documents

# ============================================================
# TELECOM — TWILIO
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_FROM=
TWILIO_WEBHOOK_SECRET=

# ============================================================
# TELECOM — TELNYX
# ============================================================

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
TELNYX_DEFAULT_FROM=
TELNYX_WEBHOOK_SECRET=

# ============================================================
# TELECOM — BANDWIDTH
# ============================================================

BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_USERNAME=
BANDWIDTH_PASSWORD=
BANDWIDTH_API_TOKEN=
BANDWIDTH_MESSAGING_APPLICATION_ID=
BANDWIDTH_VOICE_APPLICATION_ID=
BANDWIDTH_APPLICATION_ID=
BANDWIDTH_SITE_ID=
BANDWIDTH_LOCATION_ID=
BANDWIDTH_SIPPEER_ID=
BANDWIDTH_WEBHOOK_USERNAME=
BANDWIDTH_WEBHOOK_PASSWORD=
BANDWIDTH_WEBHOOK_SECRET=

# ============================================================
# VERIFY HUB FEATURE GATES
# ============================================================
VERIFY_HUB_ENABLED=
VERIFY_HUB_PROVIDERS=
VERIFY_HUB_PROVIDER_PRIORITY=

# ============================================================
# RENTAL HUB FEATURE GATES
# ============================================================
RENTAL_HUB_ENABLED=
RENTAL_HUB_PROVIDERS=
RENTAL_HUB_PROVIDER_PRIORITY=

# ============================================================
# TELECOM — JUICYSMS (LIVE VERIFIED PROVIDER)
# ============================================================
# JuicySMS v2 API: https://juicysms.com/api
# Uses bearer token authentication.
JUICYSMS_API_KEY=
JUICYSMS_BASE_URL=
JUICYSMS_TIMEOUT_MS=15000
JUICYSMS_WEBHOOK_URL=

# ============================================================
# TELECOM — TEXTVERIFIED (LIVE VERIFIED PROVIDER — US ONLY)
# ============================================================
# TextVerified v2 API: https://www.textverified.com/docs/api/v2
# Uses bearer token authentication issued after username/apikey login.
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_BASE_URL=
TEXTVERIFIED_TIMEOUT_MS=15000
TEXTVERIFIED_WEBHOOK_URL=
TEXTVERIFIED_WEBHOOK_SECRET=

# ============================================================
# TELECOM — SMSPOOL (LIVE RENTAL-ONLY PROVIDER)
# ============================================================
# SMSPool production API: https://app.smspool.net/api
# Only enabled for rental hub; verification through TextVerified.
SMSPOOL_API_KEY=
SMSPOOL_BASE_URL=
SMSPOOL_TIMEOUT_MS=15000
SMSPOOL_WEBHOOK_URL=

# ============================================================
# TELECOM — TIGERSMS (DISABLED UNTIL CONTRACT VERIFIED)
# ============================================================
# TigerSMS remains explicitly disabled pending official API contract verification.
TIGERSMS_API_KEY=
TIGERSMS_WEBHOOK_URL=
TIGERSMS_WEBHOOK_SECRET=

# ============================================================
# TELECOM — QUACKR (LIVE RENTAL-ONLY PROVIDER)
# ============================================================
# Quackr rental API: https://quackr.io/api
# Only enabled for rental hub; verification through TextVerified/JuicySMS.
QUACKR_API_KEY=
QUACKR_BASE_URL=
QUACKR_TIMEOUT_MS=15000
QUACKR_WEBHOOK_URL=

# ============================================================
# PROVIDER AUTHENTICATION — INTERNAL USE ONLY
# ============================================================
# Do NOT put INTERNAL_API_KEY or WEBHOOK_SIGNING_SECRET in Git or .env.example.
# These must be generated and stored only in Railway/Vercel production config.
INTERNAL_API_KEY=
WEBHOOK_SIGNING_SECRET=

# ============================================================
# PAYMENTS — PAYSTACK
# ============================================================

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_URL=

# ============================================================
# PAYMENTS — FLUTTERWAVE
# ============================================================

FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_URL=
FLUTTERWAVE_SECRET_HASH=

# ============================================================
# PAYMENTS — PADDLE
# ============================================================

PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

PADDLE_PRICE_VERIFICATION=
PADDLE_PRICE_RENTAL=
PADDLE_PRICE_SUB_MONTHLY=

PADDLE_SANDBOX=false

# ============================================================
# PAYMENTS — NOWPAYMENTS
# ============================================================

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ============================================================
# PAYMENTS — KORAPAY
# ============================================================

KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_WEBHOOK_SECRET=

# ============================================================
# PAYMENT / CURRENCY SETTINGS
# ============================================================

# Canonical accounting currency is USD minor units. Local currencies are display-only
# unless a payment gateway explicitly requires a settlement currency.

PAYMENT_DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,NGN,GBP,EUR,CAD,AUD,ZAR,GHS,KES,INR,AED,SAR,JPY,CNY,BRL,MXN
CURRENCY_DEFAULT=USD

FOREXRATEAPI_API_KEY=
FOREXRATEAPI_BASE_URL=https://api.forexrateapi.com
FX_PROVIDER=forexrateapi
FX_BASE_CURRENCY=USD
FOREXRATEAPI_APP_ID=
FX_CACHE_TTL_SECONDS=3600

SECONDARY_GATEWAYS_ENABLED=false
MOBILE_EXTERNAL_PAYMENTS_ENABLED=false

# ============================================================
# AIRALO — eSIM
# ============================================================

AIRALO_API_KEY=
AIRALO_API_SECRET=
AIRALO_WEBHOOK_SECRET=
AIRALO_BASE_URL=

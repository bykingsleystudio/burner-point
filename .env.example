# Burner Point environment configuration
# Keep real secrets only in ignored .env files or deployment dashboards.
# .env.example files use placeholder values only.

# =========================================
# APP / ENVIRONMENT
# =========================================
NODE_ENV=development
APP_ENV=development
APP_NAME=Burner Point
APP_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3001/api
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint
APP_VERSION=0.0.0-local
RELEASE_SHA=local
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://burnerpoint.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS=false
GLOBAL_RATE_LIMIT_MAX=60
GLOBAL_RATE_LIMIT_TTL_SECONDS=60
WEBHOOK_RATE_LIMIT_MAX=600
WEBHOOK_RATE_LIMIT_TTL_SECONDS=60
WEB_APP_URL=https://burnerpoint.vercel.app
FRONTEND_URL=https://burnerpoint.vercel.app
VERCEL_URL=burnerpoint.vercel.app

# =========================================
# DATABASE / CACHE
# =========================================
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_HOST=HOST
DB_PORT=5432
DB_USER=USERNAME
DB_PASS=PASSWORD
DB_NAME=DATABASE
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD

# =========================================
# JWT / INTERNAL SECURITY
# =========================================
JWT_ACCESS_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=REPLACE_ME_32_CHAR_KEY
ADMIN_SECRET_KEY=REPLACE_ME

# =========================================
# CLERK AUTH
# =========================================
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_BP_SPLINE_SCENE=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# =========================================
# TELECOM PROVIDERS
# =========================================
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_API_KEY=SK_REPLACE_ME
TWILIO_API_SECRET=REPLACE_ME
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_ME
TWILIO_DEFAULT_FROM=+10000000000
TWILIO_WEBHOOK_SECRET=REPLACE_ME
SMS_DEFAULT_FROM=BurnerPoint
TELNYX_API_KEY=KEY_REPLACE_ME
TELNYX_MESSAGING_PROFILE_ID=REPLACE_ME
TELNYX_CONNECTION_ID=REPLACE_ME
TELNYX_PUBLIC_KEY=REPLACE_ME
TELNYX_WEBHOOK_SECRET=REPLACE_ME
TELNYX_DEFAULT_FROM=+10000000000
TREMIL_API_KEY=REPLACE_ME
TREMIL_SECRET=REPLACE_ME
TREMIL_BASE_URL=https://api.tremil.example.com
TREMIL_WEBHOOK_SECRET=REPLACE_ME

# =========================================
# AI / OPENAI
# =========================================
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
AI_KILL_SWITCH=false

# =========================================
# OBJECT STORAGE / BACKGROUND JOBS / ANALYTICS
# =========================================
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=burner-point-private
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
QUEUE_REDIS_URL=redis://default:PASSWORD@HOST:6379
POSTHOG_API_KEY=phc_REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME

# =========================================
# PAYMENTS

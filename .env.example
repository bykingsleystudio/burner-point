# Burner Point environment configuration
# Keep real secrets only in ignored .env files or deployment dashboards.
# .env.example files use placeholder values only.

# =========================================
# APP / ENVIRONMENT
# =========================================
NODE_ENV=development
APP_ENV=development
APP_NAME=Burner Point
APP_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3001/api
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://burnerpoint.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS=false
WEB_APP_URL=https://burnerpoint.vercel.app
FRONTEND_URL=https://burnerpoint.vercel.app
VERCEL_URL=burnerpoint.vercel.app

# =========================================
# DATABASE / CACHE
# =========================================
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_HOST=HOST
DB_PORT=5432
DB_USER=USERNAME
DB_PASS=PASSWORD
DB_NAME=DATABASE
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD

# =========================================
# JWT / INTERNAL SECURITY
# =========================================
JWT_ACCESS_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=REPLACE_ME_32_CHAR_KEY
ADMIN_SECRET_KEY=REPLACE_ME

# =========================================
# CLERK AUTH
# =========================================
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# =========================================
# LEGACY OAUTH LAUNCH URLS
# =========================================
GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth?client_id=REPLACE_ME
APPLE_OAUTH_URL=https://appleid.apple.com/auth/authorize?client_id=REPLACE_ME
MICROSOFT_OAUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=REPLACE_ME

# =========================================
# TELECOM PROVIDERS
# =========================================
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_API_KEY=SK_REPLACE_ME
TWILIO_API_SECRET=REPLACE_ME
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_ME
TWILIO_DEFAULT_FROM=+10000000000
TWILIO_WEBHOOK_SECRET=REPLACE_ME
SMS_DEFAULT_FROM=BurnerPoint
VONAGE_API_KEY=REPLACE_ME
VONAGE_API_SECRET=REPLACE_ME
VONAGE_APPLICATION_ID=REPLACE_ME
VONAGE_PRIVATE_KEY=REPLACE_ME
VONAGE_DEFAULT_FROM=BurnerPoint
VONAGE_WEBHOOK_SECRET=REPLACE_ME
INFOBIP_BASE_URL=https://REPLACE_ME.api.infobip.com
INFOBIP_API_KEY=REPLACE_ME
INFOBIP_DEFAULT_FROM=BurnerPoint
INFOBIP_SENDER_ID=BurnerPoint
INFOBIP_WEBHOOK_SECRET=REPLACE_ME
BANDWIDTH_ACCOUNT_ID=REPLACE_ME
BANDWIDTH_API_TOKEN=REPLACE_ME
BANDWIDTH_APPLICATION_ID=REPLACE_ME
BANDWIDTH_WEBHOOK_SECRET=REPLACE_ME

# =========================================
# AI / OPENAI
# =========================================
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
AI_KILL_SWITCH=false

# =========================================
# OBJECT STORAGE / BACKGROUND JOBS / ANALYTICS
# =========================================
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=burner-point-private
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
QUEUE_REDIS_URL=redis://default:PASSWORD@HOST:6379
POSTHOG_API_KEY=phc_REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME

# =========================================
# PAYMENTS
# =========================================
PAYMENT_USD_TO_NGN_RATE=1600
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_ME
FLUTTERWAVE_ENCRYPTION_KEY=REPLACE_ME
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_ME
SQUAD_SECRET_KEY=sandbox_sk_REPLACE_ME
SQUAD_PUBLIC_KEY=sandbox_pk_REPLACE_ME
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_WEBHOOK_SECRET=REPLACE_ME
KORAPAY_SECRET_KEY=sk_test_REPLACE_ME
KORAPAY_PUBLIC_KEY=pk_test_REPLACE_ME
KORAPAY_ENCRYPTION_KEY=REPLACE_ME
KORAPAY_WEBHOOK_SECRET=REPLACE_ME
OPAY_MERCHANT_ID=REPLACE_ME
OPAY_PUBLIC_KEY=REPLACE_ME
OPAY_PRIVATE_KEY=REPLACE_ME
OPAY_SECRET_KEY=REPLACE_ME
OPAY_BASE_URL=https://sandboxapi.opayweb.com
OPAY_WEBHOOK_SECRET=REPLACE_ME
PADDLE_API_KEY=REPLACE_ME
PADDLE_CLIENT_TOKEN=REPLACE_ME
PADDLE_WEBHOOK_SECRET=REPLACE_ME
PADDLE_SANDBOX=true
PADDLE_PRODUCT_ID_CREDITS=pro_REPLACE_ME
PADDLE_PRODUCT_ID_RENTAL=pro_REPLACE_ME
PADDLE_PRODUCT_ID_SUB=pro_REPLACE_ME
PADDLE_PRICE_VERIFICATION=pri_REPLACE_ME
PADDLE_PRICE_RENTAL=pri_REPLACE_ME
PADDLE_PRICE_SUB_MONTHLY=pri_REPLACE_ME
NOWPAYMENTS_API_KEY=REPLACE_ME
NOWPAYMENTS_IPN_SECRET=REPLACE_ME
NOWPAYMENTS_SANDBOX=true
SECONDARY_GATEWAYS_ENABLED=false
MOBILE_EXTERNAL_PAYMENTS_ENABLED=false

# =========================================
# ESIM / PROXIES / VPN
# =========================================
ONEGLOBAL_BASE_URL=https://api.1global.com
ONEGLOBAL_PLANS_PATH=/REPLACE_WITH_PROVIDER_PLANS_PATH
ONEGLOBAL_ORDER_PATH=/REPLACE_WITH_PROVIDER_ORDER_PATH
ONEGLOBAL_API_KEY=REPLACE_ME
ONEGLOBAL_WEBHOOK_SECRET=REPLACE_ME
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_API_KEY=REPLACE_ME
BRIGHTDATA_CUSTOMER_ID=REPLACE_ME
BRIGHTDATA_ZONE=burner_point_mobile
BRIGHTDATA_PROXY_ORDER_PATH=/REPLACE_WITH_PROVIDER_PROXY_ORDER_PATH
BRIGHTDATA_WEBHOOK_SECRET=REPLACE_ME
WIREGUARD_PRIVATE_KEY=REPLACE_ME
WIREGUARD_ENDPOINT=vpn.burnerpoint.app:51820
WIREGUARD_CONTROL_BASE_URL=https://vpn-control.burnerpoint.app
WIREGUARD_CONTROL_API_KEY=REPLACE_ME
WIREGUARD_SESSION_PATH=/REPLACE_WITH_CONTROL_SESSION_PATH
WIREGUARD_WEBHOOK_SECRET=REPLACE_ME

# =========================================
# EMAIL / RESEND
# =========================================
RESEND_API_KEY=re_REPLACE_ME
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_ME
SMTP_FROM=noreply@burnerpoint.app
EMAIL_FROM=noreply@burnerpoint.app

# =========================================
# SENTRY / OBSERVABILITY
# =========================================
SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
EXPO_PUBLIC_SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
# Optional: only needed for Sentry source-map upload and release tracking during builds.
SENTRY_AUTH_TOKEN=sntrys_REPLACE_ME
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT=REPLACE_ME

# =========================================
# WEB PUBLIC ENV
# =========================================
NEXT_PUBLIC_API_URL=https://burner-point-api-production.up.railway.app/api
NEXT_PUBLIC_WS_URL=https://burner-point-api-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=REPLACE_ME
NEXT_PUBLIC_PADDLE_SANDBOX=true

# =========================================
# MOBILE PUBLIC ENV
# =========================================
EXPO_PUBLIC_API_URL=https://burner-point-api-production.up.railway.app/api
EXPO_PUBLIC_WEB_URL=https://burnerpoint.vercel.app
EXPO_PUBLIC_APP_URL=burnerpoint://

# =========================================
# DEPLOYMENT / PLATFORM
# =========================================
RAILWAY_ENVIRONMENT=production
VERCEL_ENV=preview
GITHUB_REPOSITORY=bykingsleystudio/burner-point
NEON_PROJECT_ID=REPLACE_ME
EXPO_PROJECT_ID=REPLACE_ME
DATABASE_CLIENT=DBeaver
APPLE_APP_IDENTIFIER=app.burnerpoint.mobile
APPLE_TEAM_ID=REPLACE_ME
APP_STORE_CONNECT_KEY_ID=REPLACE_ME
GOOGLE_PLAY_PACKAGE_NAME=app.burnerpoint.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=REPLACE_ME


SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_ME
SMTP_FROM=noreply@burnerpoint.app
EMAIL_FROM=noreply@burnerpoint.app

# =========================================
# SENTRY / OBSERVABILITY
# =========================================
SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
EXPO_PUBLIC_SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID

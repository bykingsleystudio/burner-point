# =========================================
# ESIM / PROXIES / VPN
# =========================================
AIRALO_BASE_URL=https://partners.airalo.com/api/v2
AIRALO_CLIENT_ID=REPLACE_ME
AIRALO_CLIENT_SECRET=REPLACE_ME
AIRALO_PLANS_PATH=/REPLACE_WITH_AIRALO_PLANS_PATH

## =========================================
## Burner Point Production Environment Variables
## Supabase-Powered Backend Configuration
## =========================================
## CRITICAL: This file contains safe non-secret defaults plus required variable names.
## Real secrets must be added to .env (gitignored) or deployment dashboards.
## =========================================

## =========================================
## Core Application
## =========================================
NODE_ENV=production
APP_NAME=Burner Point
APP_URL=https://burnerpoint.com
API_URL=https://api.burnerpoint.com
NEXT_PUBLIC_APP_URL=https://burnerpoint.com
NEXT_PUBLIC_API_URL=https://api.burnerpoint.com
NEXT_PUBLIC_WS_URL=wss://api.burnerpoint.com

## =========================================
## Supabase Configuration
## =========================================
## Get these from your Supabase project settings:
## 1. Go to https://app.supabase.com
## 2. Select your project (or create new)
## 3. Go to Project Settings > API
## 4. Copy the values below
## =========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

## =========================================
## Supabase Database (Postgres)
## =========================================
## Connection strings from Project Settings > Database
## =========================================
DATABASE_URL=
DIRECT_DATABASE_URL=
POOLER_URL=

## =========================================
## Supabase Storage
## =========================================
## Buckets will be created automatically or via dashboard
## =========================================
SUPABASE_STORAGE_USER_UPLOADS_BUCKET=bp-user-uploads
SUPABASE_STORAGE_MEDIA_BUCKET=bp-media
SUPABASE_STORAGE_VERIFICATION_ASSETS_BUCKET=bp-verification-assets
SUPABASE_STORAGE_DOCUMENTS_BUCKET=bp-documents

## =========================================
## Authentication (Supabase Auth)
## =========================================
## OAuth providers configured in Supabase Dashboard > Authentication > Providers
## =========================================
# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (from Apple Developer)
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Microsoft OAuth (from Azure AD)
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

## Telecom Providers
## =========================================
## Configure in respective provider dashboards
## =========================================

# Twilio (Project Settings > API Keys)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_FROM=
TWILIO_WEBHOOK_SECRET=

# Telnyx (Portal > API Keys)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
TELNYX_DEFAULT_FROM=
TELNYX_WEBHOOK_SECRET=

# Bandwidth (Portal > API Settings)
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_USERNAME=
BANDWIDTH_PASSWORD=
BANDWIDTH_API_TOKEN=
BANDWIDTH_MESSAGING_APPLICATION_ID=
BANDWIDTH_VOICE_APPLICATION_ID=
BANDWIDTH_APPLICATION_ID=
BANDWIDTH_SITE_ID=
BANDWIDTH_LOCATION_ID=
BANDWIDTH_SIPPEER_ID=
BANDWIDTH_WEBHOOK_USERNAME=
BANDWIDTH_WEBHOOK_PASSWORD=
BANDWIDTH_WEBHOOK_SECRET=

## =========================================
## Payment Providers
## =========================================
## Configure webhooks in each provider dashboard
## Payment webhook aliases are served at:
## https://api.burnerpoint.com/api/webhooks/{provider}
## =========================================

# RevenueCat (Projects > API Keys / Webhooks)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_BP_MESSENGER=bp_messenger_pro
REVENUECAT_ENTITLEMENT_BP_SECURE_TUNNEL=bp_secure_tunnel
REVENUECAT_ENTITLEMENT_BP_PREMIUM=bp_premium
REVENUECAT_OFFERING_DEFAULT=default
REVENUECAT_OFFERING_MESSENGER=bp_messenger
REVENUECAT_OFFERING_VPN=bp_secure_tunnel
REVENUECAT_OFFERING_PREMIUM=bp_premium

# Paystack (Dashboard > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave (Dashboard > API Keys)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Paddle (Developer Tools > API Keys)
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=false
PADDLE_PRICE_BP_MESSENGER_US_MONTHLY=
PADDLE_PRICE_BP_MESSENGER_CA_MONTHLY=
PADDLE_PRICE_BP_MESSENGER_UK_MONTHLY=
PADDLE_PRICE_BP_SECURE_TUNNEL_BASIC_MONTHLY=
PADDLE_PRICE_BP_SECURE_TUNNEL_PRO_MONTHLY=
PADDLE_PRICE_BP_PREMIUM_MONTHLY=

# NOWPayments (Merchant Tools > API Keys)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Korapay (Dashboard > API)
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_WEBHOOK_SECRET=

# Payment Configuration
PAYMENT_USD_TO_NGN_RATE=1500
SECONDARY_GATEWAYS_ENABLED=false
MOBILE_EXTERNAL_PAYMENTS_ENABLED=false

## =========================================
## Service Providers
## =========================================

# Airalo (Partner Portal > API)
AIRALO_API_KEY=
AIRALO_API_SECRET=
AIRALO_WEBHOOK_SECRET=
AIRALO_BASE_URL=https://partners-api.airalo.com
AIRALO_PLANS_PATH=/v2/packages
AIRALO_ORDER_PATH=/v2/orders
ESIM_ORDER_PRICE_USD_CENTS=500

# Oxylabs (Dashboard > API)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_API_KEY=
OXYLABS_BASE_URL=
OXYLABS_PROXY_ORDER_PATH=
OXYLABS_WEBHOOK_SECRET=

# Smartproxy (Dashboard > API)
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
SMARTPROXY_API_KEY=
SMARTPROXY_BASE_URL=
SMARTPROXY_PROXY_ORDER_PATH=
SMARTPROXY_WEBHOOK_SECRET=
PROXY_ORDER_DAILY_PRICE_USD_CENTS=300

# WireGuard / VPN
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_SERVER_ENDPOINT=
WIREGUARD_DNS=1.1.1.1,8.8.8.8
WIREGUARD_ALLOWED_IPS=0.0.0.0/0,::/0
WIREGUARD_CONTROL_BASE_URL=
WIREGUARD_SESSION_PATH=/sessions
WIREGUARD_CONTROL_API_KEY=
WIREGUARD_WEBHOOK_SECRET=
VPN_SESSION_PRICE_USD_CENTS=500

## =========================================
## Email (Resend)
## =========================================
RESEND_API_KEY=
SUPPORT_EMAIL=support@burnerpoint.com
RESEND_FROM_EMAIL=Burner Point <no-reply@burnerpoint.com>

## =========================================
## Monitoring & Analytics
## =========================================

# Sentry (Project Settings > API Keys)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (Project Settings > API Keys)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

## =========================================
## Real-Time / Queue (Redis)
## =========================================
REDIS_URL=
SOCKET_IO_REDIS_URL=
QUEUE_REDIS_URL=

## =========================================
## OpenAI / AI Services
## =========================================
OPENAI_API_KEY=

## =========================================
## Security & JWT
## =========================================
ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
WEBHOOK_SIGNING_SECRET=
INTERNAL_API_KEY=

## =========================================
## Rate Limiting & CORS
## =========================================
CORS_ALLOWED_ORIGINS=https://burnerpoint.com,https://www.burnerpoint.com
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_TTL_SECONDS=60
WEBHOOK_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_TTL_SECONDS=60
CORS_ALLOW_VERCEL_PREVIEWS=false

## =========================================
## Web Public Environment (Safe to Expose)
## =========================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_PAYMENT_USD_TO_NGN_RATE=1500
NEXT_PUBLIC_SUPPORT_EMAIL=support@burnerpoint.com
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=https://t.me/burnerpoint
NEXT_PUBLIC_COMMUNITY_TELEGRAM_URL=https://t.me/burnerpointapp

## =========================================
## Mobile Public Environment (Safe to Expose)
## =========================================
EXPO_PUBLIC_API_URL=https://api.burnerpoint.com
EXPO_PUBLIC_WEB_URL=https://burnerpoint.com
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_PAYMENT_USD_TO_NGN_RATE=1500

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=burnerpoint

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://burnerpoint:secret@localhost:5432/burnerpoint
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_SECRET=your_webhook_secret
TWILIO_DEFAULT_FROM=+15550000000

# ─── Telnyx ───────────────────────────────────────────────────────────────────
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_CONNECTION_ID=your_connection_id

# ─── Payment Gateways ─────────────────────────────────────────────────────────
# Priority 1 — Flutterwave (NGN primary)
# Keys from: dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash

# Priority 2 — Paystack (NGN)
# Keys from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Priority 3 — Squad by GTCO (NGN)
# Keys from: squadco.com dashboard
SQUAD_SECRET_KEY=sandbox_sk_xxxxxxxxxxxxxxxxxxxx
SQUAD_PUBLIC_KEY=sandbox_pk_xxxxxxxxxxxxxxxxxxxx
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# Priority 4 — Korapay (NGN)
# Keys from: app.korapay.com → Settings → API Keys
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# Priority 5 — OPay Merchant (NGN)
# Keys from: merchant.opaycheckout.com → Developer → API Keys
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_PUBLIC_KEY=your_opay_public_key
OPAY_PRIVATE_KEY=your_opay_private_key
OPAY_BASE_URL=https://sandboxapi.opayweb.com

# Priority 6 — Paddle (International cards/subscriptions)
# Keys from: vendors.paddle.com → Developer Tools → Authentication
# PADDLE_SANDBOX=true for sandbox, false for production
PADDLE_VENDOR_ID=your_paddle_vendor_id
PADDLE_API_KEY=your_paddle_api_key
PADDLE_PUBLIC_KEY=your_paddle_public_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_SANDBOX=true
# Price IDs for each credit package (create in Paddle dashboard → Catalog → Prices)
PADDLE_PRICE_STARTER=pri_xxxxxxxxxxxxxxxx
PADDLE_PRICE_BASIC=pri_xxxxxxxxxxxxxxxx
PADDLE_PRICE_VALUE=pri_xxxxxxxxxxxxxxxx
PADDLE_PRICE_PRO=pri_xxxxxxxxxxxxxxxx
PADDLE_PRICE_POWER=pri_xxxxxxxxxxxxxxxx
PADDLE_PRICE_BUSINESS=pri_xxxxxxxxxxxxxxxx

# Priority 7 — NOWPayments (Crypto: BTC, ETH, USDT, etc.)
# Keys from: nowpayments.io → My Account → API Keys
# IPN secret: nowpayments.io → My Account → IPN Settings
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SANDBOX=true

# ─── AI / OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@burnerpoint.app

# ─── Misc ─────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_
ADMIN_SECRET_KEY=CHANGE_ME_ADMIN_SECRET
SENTRY_DSN=https://xxxx@sentry.io/xxxx
